@host = https://localhost:7242
# Paste the token returned by login/register here
@token =

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "you@example.com", "password": "ChangeMe123!", "displayName": "You" }

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "you@example.com", "password": "ChangeMe123!" }

### List todos
GET {{host}}/api/todos
Authorization: Bearer {{token}}

### Create a todo
POST {{host}}/api/todos
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Try the API", "priority": "Medium", "status": "Todo" }

### List meetings
GET {{host}}/api/meetings
Authorization: Bearer {{token}}

### Pull changes since a point in time
GET {{host}}/api/sync?since=2026-01-01T00:00:00Z
Authorization: Bearer {{token}}
